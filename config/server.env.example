# Copy to config/server.local.env (ignored). Generate two independent secrets:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SECRET_KEY=replace-with-at-least-32-random-characters
DEVICE_ID=epaper-pi-zero2
DEVICE_TOKEN=replace-with-another-32-random-characters
ADMIN_USERNAME=admin
# Generate with: .venv/bin/python -m src.server hash-password
# Keep single quotes: Docker Compose otherwise interpolates dollar signs in hashes.
ADMIN_PASSWORD_HASH='replace-with-generated-scrypt-hash'
# Local testing uses HTTP. Set your HTTPS management domain for NAS deployment.
BASE_URL=http://192.168.76.109:8088
# Container default is /data/server.sqlite3. Override only when running locally.
